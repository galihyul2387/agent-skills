# Contoh Multi-stage Dockerfile untuk Aplikasi Node.js (Backend/Frontend)
# =====================================================================
# Dockerfile ini mengikuti best practice dari skill 05-deploy:
# - Multi-stage build untuk image yang kecil dan efisien
# - Non-root user untuk keamanan
# - HEALTHCHECK directive untuk monitoring container
# - Layer caching yang optimal

# ===========================
# STAGE 1: Build
# ===========================
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Salin file dependensi terlebih dahulu (untuk layer caching optimal)
COPY package.json package-lock.json ./

# Instal dependensi (hanya production + dev untuk build)
RUN npm ci

# Salin seluruh source code
COPY . .

# Build aplikasi
RUN npm run build

# ===========================
# STAGE 2: Production Runtime
# ===========================
FROM node:20-alpine AS production

# Metadata image
LABEL maintainer="tim-dev@perusahaan.com"
LABEL description="Production image untuk auth-service"
LABEL version="1.0.0"

# Buat user non-root untuk keamanan
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Salin hanya file yang dibutuhkan dari stage build
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Ganti ke user non-root
USER appuser

# Expose port aplikasi
EXPOSE 3000

# Health check untuk monitoring container
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Jalankan aplikasi
CMD ["node", "dist/main.js"]
